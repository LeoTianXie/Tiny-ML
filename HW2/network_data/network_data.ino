// Actual class labels: 0 = attack, 1 = normal
const uint8_t y_test[NUM_SAMPLES] = { 1, 0, 0, 0, 1, 0, 1, 0, 1, 1 };

void setup() {
    Serial.begin(115200);
    while (!Serial);   // Wait for Serial Monitor to connect (needed for native-USB boards)
    static tflite::MicroErrorReporter micro_error_reporter;
    error_reporter = &micro_error_reporter;

    const tflite::Model* model = tflite::GetModel(network_model);
    if (model->version() != TFLITE_SCHEMA_VERSION) {
        Serial.println("Model version does not match schema version.");
        return;
    }

    static tflite::MicroMutableOpResolver<10> micro_op_resolver;
    micro_op_resolver.AddFullyConnected();
    micro_op_resolver.AddSoftmax();
    micro_op_resolver.AddQuantize();
    micro_op_resolver.AddDequantize();

    static tflite::MicroInterpreter static_interpreter(
        model, micro_op_resolver, tensor_arena, TENSOR_ARENA_SIZE, error_reporter);
    interpreter = &static_interpreter;

    if (interpreter->AllocateTensors() != kTfLiteOk) {
        Serial.println("Failed to allocate tensors!");
        return;
    }

    input  = interpreter->input(0);
    output = interpreter->output(0);
}

void loop() {
    for (uint8_t i = 0; i < NUM_SAMPLES; i++) {

        // Load the i-th test sample into the input tensor
        for (int j = 0; j < NUMBER_OF_INPUTS; j++) {
            input->data.f[j] = X_test[i][j];
        }

        // Run inference
        if (interpreter->Invoke() != kTfLiteOk) {
            Serial.println("Failed to invoke!");
            continue;
        }

        // Q5(a): Obtain prediction from output tensor and determine predicted class label.
        // Output tensor layout: [P(attack), P(normal)] — attack = 0, normal = 1
        float pred_attack   = output->data.f[0];
        float pred_normal   = output->data.f[1];
        float prediction    = max(pred_attack, pred_normal);  // confidence of predicted class
        int predicted_class = (pred_normal > pred_attack) ? 1 : 0;

        // Q5(b): Print Sample #, Predicted Class, and Actual Class to the Serial Monitor.
        Serial.print("Sample #");
        Serial.print(i + 1);
        Serial.print("  |  Predicted Class: ");
        Serial.print(predicted_class == 1 ? "normal" : "attack");
        Serial.print("  |  Actual Class: ");
        Serial.println(y_test[i] == 1 ? "normal" : "attack");

        // Brief pause between samples
        delay(1000);
    }

    // Long pause before repeating the cycle
    delay(10000);
}
